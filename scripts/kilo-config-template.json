{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git pull*": "allow",
      "git fetch*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run build*": "allow",
      "pytest*": "allow",
      "cargo test*": "allow",
      "go test*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "echo*": "allow",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "chmod -R*": "deny",
      "chown -R*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "docker*": "deny",
      "curl*": "ask",
      "wget*": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*secret*": "deny",
      "*password*": "deny",
      "*.key": "deny",
      "*.pem": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "doom_loop": "deny",
    "external_directory": "deny"
  }
}
